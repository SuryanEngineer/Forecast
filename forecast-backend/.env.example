# Copy this file to .env and fill in real values.
# See README_SETUP.md for exactly where to get each of these, step by step.

# --- Database ---
# Free Postgres options: Supabase (supabase.com) or Neon (neon.tech).
# IMPORTANT: use the Session Pooler connection string on Supabase, not the
# direct connection -- the direct connection is IPv6-only on the free
# tier and will hang/refuse on most home networks. Session Pooler runs
# over IPv4. Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# --- Redis ---
# For a single-instance deploy (one Render web service, no separate
# background worker) you don't need Redis at all -- set REDIS_ENABLED=false
# and leave REDIS_URL as the placeholder below. This runs dividend/treasury
# jobs synchronously in-process and fans out live prices via an in-process
# substitute instead of Redis pub/sub (see app/core/config.py's
# REDIS_ENABLED and app/services/local_pubsub.py). This is the recommended
# setting for the free-tier deployment guide.
#
# Only set REDIS_ENABLED=true (and fill in a real REDIS_URL below, e.g.
# Upstash at upstash.com -- requires TLS, scheme MUST be "rediss://" not
# "redis://") once you're running more than one instance of this app and
# need Redis to coordinate across them -- at which point you'd also need
# to run a separate `rq worker forecast-default --url $REDIS_URL` process.
REDIS_ENABLED=false
REDIS_URL=rediss://default:<password>@<host>:6379

# --- Auth ---
# Generate a real secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-your-own-64-char-hex-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Platform economics ---
# One-time seed for the FIRST treasury rate ever created. After that,
# change it via POST /admin/treasury/rate instead of this file.
# Every other economic knob (quick buy/sell slippage, dividend fee, bot
# liquidity ladder, transaction fee, auction entry fee, dividend pools,
# starting balance) lives in the database from the start and is changed
# via GET/POST /admin/economic-parameters -- see
# app/services/economic_params_service.py.
# 0.01 = 1% APY, matching the validated economy simulation's cash treasury
# yield (0.02%/tournament x ~50 tournaments/chapter).
DEFAULT_TREASURY_ANNUAL_RATE=0.01

# --- Misc ---
ENV=development
CORS_ORIGINS=*

# --- Bot trading loop ---
# Whether the background bot-trading loop runs at all, and how often (in
# seconds) it ticks. The actual trading behavior (sizing, strategy mix,
# etc.) is NOT here -- it's admin-tunable at runtime via the "bots.*" keys
# in GET/POST /admin/economic-parameters. See
# app/services/bot_trading_service.py.
BOT_TRADING_ENABLED=true
BOT_TICK_INTERVAL_SECONDS=20

# Demo-mode environment. Loaded instead of .env when FORECAST_ENV_FILE=.env.demo
# is set (demo_seed.py sets this automatically if you don't). See
# DEMO_MODE.md for the full picture.
#
# Nothing in this file is secret -- it's a fully local, zero-external-service
# sandbox with fake money and fake players. Safe to commit.

# --- Database: a local SQLite file, not the real Postgres database. ---
DATABASE_URL=sqlite:///./demo.db

# --- Redis: unused in demo mode (see app/services/local_pubsub.py and
# app/jobs/tasks.py), left as a harmless placeholder. No Redis instance
# needs to be running for demo mode to work. ---
REDIS_URL=redis://unused-in-demo-mode:6379/0
REDIS_ENABLED=false

# --- Demo mode switch -- this is what actually changes behavior. ---
DEMO_MODE=true
DEMO_TOURNAMENT_INTERVAL_SECONDS=180

# --- Auth. A separate secret from the real .env's -- demo tokens should
# never be valid against the real product and vice versa. ---
JWT_SECRET_KEY=demo-mode-not-a-real-secret-do-not-reuse
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Platform economics: same locked-in starting numbers as production. ---
DEFAULT_TREASURY_ANNUAL_RATE=0.01

# --- Misc ---
ENV=demo
# Vite's dev server default port -- adjust if you serve the demo frontend
# from somewhere else.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Bot trading loop: a bit livelier than production's default so the
# demo market visibly moves while someone's watching it. ---
BOT_TRADING_ENABLED=true
BOT_TICK_INTERVAL_SECONDS=15

# --- Secrets: never commit these ---
.env
*.env
!.env.example

# --- Python (forecast-backend, forecast_sim) ---
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Simulator output artifacts (regenerable, often large) ---
forecast_sim/**/output/
forecast_sim/**/*.png
forecast_sim/**/results/

# --- Demo mode's local SQLite database (regenerated by demo_seed.py,
# never the canonical source of anything) ---
forecast-backend/demo.db
